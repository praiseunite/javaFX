<?xml version="1.0" encoding="UTF-8"?>
<!--
  Session 11B — Data Structures, By Hand.

  Our addition: the Presenter's Manual has no bullet for this session. Session 11 covers the
  manual's four legacy bullets (Enumeration, BitSet, Stack, Dictionary); this project is the
  modern side, built from nothing so that nothing inside it is magic.

  Students write a dynamic array, a hash map with buckets and chaining, and a ring-buffer deque,
  then run ONE shared check suite against their versions and the JDK's. Cost is counted, never
  timed: every number this project prints is deterministic, so re-running changes nothing.

  Open this folder in IntelliJ (File → Open → select the folder that contains this pom.xml).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.aptech</groupId>
    <artifactId>s11b-data-structures-by-hand</artifactId>
    <version>1.0</version>
    <name>Session 11B - Data Structures, By Hand</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
